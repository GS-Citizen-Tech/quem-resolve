# Copie para .env e preencha. O .env nunca vai para o Git.
# Cada módulo começa em "mock" e troca para a implementação real quando ficar pronto.
# LLM da análise do relato (Front, critério 1): mock | gemini. Saída sempre em JSON validado pelo Pydantic (AnaliseLLM).
LLM_PROVIDER=gemini
# Chave do Google AI Studio. Vazio = usa a VISAO_RESERVA_CHAVE (a mesma chave serve para os dois).
LLM_API_KEY=
# Lista separada por vírgula: sem cota (429) ou lento, tenta o próximo. Vazio = gemini-3.5-flash-lite,gemini-3.5-flash
LLM_MODEL=
VISAO_PROVIDER=yolo      # mock | yolo (YOLOv8n RDD2022 em ONNX)
YOLO_MODELO=modelos/rdd2022-n-r2.onnx
# YOLO_LIMIAR vazio = usa o limiar do cidadão escolhido no treino (0,24)
YOLO_LIMIAR=
# Limiar maior para algumas classes, só na foto do cidadão (D20 = couro de jacaré, confunde com piso de bloquinho)
YOLO_LIMIAR_CLASSE=D20=0.75
# Teto da confiança: nota do LLM e confiança final (a IA nunca mostra 99-100%)
LLM_TETO_CONFIANCA=0.85
TETO_CONFIANCA=0.95
# Reserva multimodal da foto (fio, lixo, poste, árvore, alagamento...): off | mock | gemini
VISAO_RESERVA=gemini
# Lista separada por vírgula: se um modelo estiver sobrecarregado ou sem cota (429), tenta o próximo.
# Plano gratuito do Gemini: cerca de 20 pedidos por dia por modelo.
VISAO_RESERVA_MODELO=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
# Chave do Gemini (Google AI Studio). Vazio = usa a LLM_API_KEY
VISAO_RESERVA_CHAVE=
RAG_PROVIDER=mock

# Assistente de voz (disciplina 08): mock | real. "real" exige: pip install -r requirements-voz.txt
# STT faster-whisper e TTS Piper rodam na máquina (a voz não sai dela); só o TEXTO vai para o LLM.
VOZ_PROVIDER=mock
VOZ_STT_MODELO=small          # tiny | base | small | medium (em CPU, small)
VOZ_STT_DEVICE=cpu            # cpu | cuda | auto
# LLM da voz: qualquer API compatível com a OpenAI. Chave própria (a LLM_API_KEY é a do Gemini).
# Groq (gratuito): VOZ_LLM_BASE_URL=https://api.groq.com/openai/v1  VOZ_LLM_MODELO=openai/gpt-oss-120b
# OpenAI (barato, ~US$ 0,0002 por pergunta; o gpt-4.1-nano foi descontinuado): VOZ_LLM_BASE_URL=https://api.openai.com/v1  VOZ_LLM_MODELO=gpt-4o-mini
VOZ_LLM_BASE_URL=https://api.groq.com/openai/v1
VOZ_LLM_API_KEY=
VOZ_LLM_MODELO=openai/gpt-oss-120b
# Ollama local (nada sai da máquina): VOZ_LLM_BASE_URL=http://localhost:11434/v1  VOZ_LLM_API_KEY=ollama  VOZ_LLM_MODELO=qwen2.5:7b
VOZ_TTS_MOTOR=piper           # piper (local) | edge (nuvem Microsoft) | off (voz do navegador)
# VOZ_PIPER_VOZ=modelos/piper/pt_BR-faber-medium.onnx
# VOZ_RAG_LIMIAR=0.40
# VOZ_AQUECER=1               (carrega os modelos na subida da API)

# Endereço por extenso ("Você está em Rua Augusta, 900"): mock | nominatim (OpenStreetMap, grátis, sem chave)
GEO_PROVIDER=nominatim
# Bairros (v1.3): a API baixa os 96 distritos do IBGE sozinha na 1ª subida e guarda em app/data/distritos_sp.geojson.
# DISTRITOS_ARQUIVO vazio = esse arquivo. DISTRITOS_BAIXAR=0 desliga o download.
DISTRITOS_ARQUIVO=
DISTRITOS_BAIXAR=1

CORS_ORIGINS=http://localhost:3000
# Deploy: aceita também os links da Vercel do projeto (produção e prévias). Vazio = desligado.
CORS_REGEX=
LIMIAR_CONFIANCA=0.5
LIMIAR_IOT=0.7
SEED_OCORRENCIAS=120

# Frota pelo console (v1.0): vídeo curto ou fotos enviados pelo gestor. Vazio = padrões do config.py
# FROTA_PASTA=            (pasta temporária do sistema)
# FROTA_MAX_MB=80
# FROTA_MAX_SEGUNDOS=60   (vídeo mais longo: só o começo é analisado)
# FROTA_MAX_FOTOS=60

# Banco: vazio = memória (os dados somem ao reiniciar). Com o Supabase: Project Settings > Database >
# Connection string > "Session pooler" (porta 5432), trocando [YOUR-PASSWORD] pela senha do banco.
# A API cria as tabelas sozinha na primeira subida. NUNCA cole esse endereço no chat nem no Git.
DATABASE_URL=
# Fotos no Storage privado do Supabase: Project Settings > API (Project URL e a chave "secret"/service_role).
# Vazio = fotos em memória. A chave secreta fica SÓ aqui, nunca no web/.
SUPABASE_URL=
SUPABASE_CHAVE_SECRETA=
STORAGE_BUCKET=fotos
LINK_FOTO_MINUTOS=60
RETENCAO_DIAS=90

# Login de demonstração do gestor: usuario:senha:orgao_id:Nome (vírgula separa vários)
GESTORES=marina:demo-123:subprefeitura:Marina,joao:demo-123:sabesp:João
AUTH_SEGREDO=troque-por-um-texto-longo-e-aleatorio
AUTH_HORAS=8
# Chave do robô de RPA para marcar ocorrências como enviadas (cabeçalho X-Robo-Chave)
ROBO_CHAVE=
