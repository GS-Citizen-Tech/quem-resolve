# Copie para .env e preencha. O .env nunca vai para o Git.
# Cada módulo começa em "mock" e troca para a implementação real quando ficar pronto.
LLM_PROVIDER=mock        # mock | gemini | groq
LLM_API_KEY=
LLM_MODEL=
VISAO_PROVIDER=yolo      # mock | yolo (YOLOv8n RDD2022 em ONNX)
YOLO_MODELO=modelos/rdd2022-n-r2.onnx
# YOLO_LIMIAR vazio = usa o limiar do cidadão escolhido no treino (0,24)
YOLO_LIMIAR=
# Reserva multimodal da foto (fio, lixo, poste, árvore, alagamento...): off | mock | gemini
VISAO_RESERVA=gemini
# Lista separada por vírgula: se um modelo estiver sobrecarregado ou sem cota (429), tenta o próximo.
# Plano gratuito do Gemini: cerca de 20 pedidos por dia por modelo.
VISAO_RESERVA_MODELO=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
# Chave do Gemini (Google AI Studio). Vazio = usa a LLM_API_KEY
VISAO_RESERVA_CHAVE=
RAG_PROVIDER=mock
VOZ_PROVIDER=mock

CORS_ORIGINS=http://localhost:3000
LIMIAR_CONFIANCA=0.5
LIMIAR_IOT=0.7
SEED_OCORRENCIAS=120

# Frota pelo console (v1.0): vídeo curto ou fotos enviados pelo gestor. Vazio = padrões do config.py
# FROTA_PASTA=            (pasta temporária do sistema)
# FROTA_MAX_MB=80
# FROTA_MAX_SEGUNDOS=60   (vídeo mais longo: só o começo é analisado)
# FROTA_MAX_FOTOS=60

# Banco: vazio = memória (os dados somem ao reiniciar). Com o Supabase: Project Settings > Database >
# Connection string > "Session pooler" (porta 5432), trocando [YOUR-PASSWORD] pela senha do banco.
# A API cria as tabelas sozinha na primeira subida. NUNCA cole esse endereço no chat nem no Git.
DATABASE_URL=
# Fotos no Storage privado do Supabase: Project Settings > API (Project URL e a chave "secret"/service_role).
# Vazio = fotos em memória. A chave secreta fica SÓ aqui, nunca no web/.
SUPABASE_URL=
SUPABASE_CHAVE_SECRETA=
STORAGE_BUCKET=fotos
LINK_FOTO_MINUTOS=60
RETENCAO_DIAS=90

# Login de demonstração do gestor: usuario:senha:orgao_id:Nome (vírgula separa vários)
GESTORES=marina:demo-123:subprefeitura:Marina,joao:demo-123:sabesp:João
AUTH_SEGREDO=troque-por-um-texto-longo-e-aleatorio
AUTH_HORAS=8
# Chave do robô de RPA para marcar ocorrências como enviadas (cabeçalho X-Robo-Chave)
ROBO_CHAVE=
